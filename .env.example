# Operator secrets. Copy to .env (which is git-ignored). Never commit real values.

# --- Vertex AI (default auth) ---
# Point at a service-account key file, or use `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# --- Paid Gemini API key (only if provider.auth = "api_key") ---
# Must be a PAID-tier key. Free-tier keys are refused at startup.
GOOGLE_API_KEY=

# --- Anthropic (optional, for the A/B stub once implemented) ---
ANTHROPIC_API_KEY=
